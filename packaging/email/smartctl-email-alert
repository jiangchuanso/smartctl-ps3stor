#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
smartctl-email-alert — 基于 smartctl 的硬盘 SMART 邮件预警

运行 smartctl 采集每块磁盘的 SMART 属性与整体健康自检结果，
按「模板值」(阈值) 逐项比对：任一指标低于(below)或高于(above)模板值即触发
SMTP 邮件告警。支持对持续相同的告警做冷却，避免邮件轰炸。

配置文件: /etc/smartctl/email.conf  (INI 格式, 见 email.conf.example)
也可用环境变量 SMARTCTL_EMAIL_CONF 指定其它路径。

用法:
    smartctl-email-alert                 # 按配置执行告警检查
    smartctl-email-alert --dry-run       # 打印将要发送的告警, 不真正发邮件
"""
import configparser
import hashlib
import json
import os
import re
import smtplib
import ssl
import subprocess
import sys
from datetime import datetime, timezone

DEFAULT_CONF = "/etc/smartctl/email.conf"
SMARTCTL = "smartctl"
DEFAULT_STATE_FILE = "/var/lib/smartctl/email-alert-state.json"

# 哪些属性名被视为「温度」(取其 RAW 值, 单位 ℃)
TEMP_ATTR_NAMES = ("Temperature_Celsius", "Temperature", "Airflow_Temperature_Cel")


# --------------------------------------------------------------------------
# 配置
# --------------------------------------------------------------------------
def load_config(path):
    # optionxform=str 保留键名大小写(阈值属性名需与 smartctl 输出大小写一致)
    cp = configparser.ConfigParser()
    cp.optionxform = str
    cp["smtp"] = {
        "host": "localhost",
        "port": "25",
        "user": "",
        "password": "",
        "use_tls": "false",
        "use_ssl": "false",
        "from": "smartctl@localhost",
        "to": "root@localhost",
        "subject_prefix": "[SMART Alert]",
    }
    cp["alert"] = {
        "mode": "alert",              # alert = 超阈值才发; daily = 每次运行都发完整报告
        "health_check": "true",       # 使用 smartctl -H 整体健康自检
        "temp_max": "",               # 便捷温度上限(℃), 留空表示不检查; 等同 Temperature raw:above:VALUE
        "cooldown_minutes": "60",     # 同一告警重复发送的最小间隔(0=不冷却)
        "scan_all": "true",           # true=自动扫描全部磁盘; false=仅检查 [alert].disks
        "disks": "",                  # scan_all=false 时逗号分隔的设备列表, 如 /dev/sda,/dev/sdb
        "state_file": DEFAULT_STATE_FILE,
    }
    cp["smartctl"] = {
        "path": SMARTCTL,
        "extra_args": "",             # 额外传给 smartctl 的参数, 一般留空
    }
    cp["thresholds"] = {
        # 模板值: 属性名 = 字段:方向:阈值[,字段:方向:阈值]
        #   字段 value=归一化值(通常越大越好), raw=原始计数值
        #   方向 below=低于阈值告警, above=高于阈值告警
        # 例:
        # Reallocated_Sector_Ct = value:below:90, raw:above:0
        # Current_Pending_Sector = raw:above:0
        # Offline_Uncorrectable = raw:above:0
        # UDMA_CRC_Error_Count = raw:above:10
        # Power_On_Hours = raw:above:43800
    }
    if os.path.exists(path):
        cp.read(path)
    return cp


# --------------------------------------------------------------------------
# 磁盘发现 & SMART 采集
# --------------------------------------------------------------------------
def discover_disks(cfg):
    """返回 [(device, dtype), ...]"""
    if cfg["alert"].getboolean("scan_all"):
        out = run_smartctl(cfg, ["--scan", "-d", "ata"])
        out += run_smartctl(cfg, ["--scan", "-d", "scsi"])
        disks = []
        for line in out.splitlines():
            line = line.strip()
            if not line or line.startswith("#") or line.startswith("Warning"):
                continue
            # 形如: /dev/sda -d ata # ...
            m = re.match(r"^(\S+)\s+-d\s+(\S+)", line)
            if m:
                disks.append((m.group(1), m.group(2)))
            elif re.match(r"^(\S+)\s", line):
                disks.append((line.split()[0], ""))
        # 去重(ata 与 scsi 扫描可能重复同一设备)
        seen = set()
        uniq = []
        for dev, dtype in disks:
            if dev not in seen:
                seen.add(dev)
                uniq.append((dev, dtype))
        return uniq
    return [(d.strip(), "") for d in cfg["alert"].get("disks", "").split(",") if d.strip()]


def run_smartctl(cfg, args):
    path = cfg["smartctl"]["path"]
    extra = cfg["smartctl"].get("extra_args", "")
    cmd = [path] + (extra.split() if extra else []) + list(args)
    try:
        res = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            timeout=120, text=True,
        )
        return res.stdout or ""
    except Exception as exc:  # noqa: BLE001
        return "ERROR: 无法运行 smartctl (%s): %s" % (path, exc)


def get_disk_report(cfg, device, dtype):
    darg = ["-d", dtype] if dtype else []
    # -i 基本信息, -H 健康自检, -A SMART 属性表
    return run_smartctl(cfg, darg + ["-i", "-H", "-A", device])


# --------------------------------------------------------------------------
# 解析
# --------------------------------------------------------------------------
def parse_smart(report, device):
    info = {
        "device": device,
        "model": "",
        "serial": "",
        "health": None,        # PASSED / FAILED / None
        "temperature": None,   # ℃ (RAW)
        "attributes": {},      # name -> {id, value, worst, thresh, raw}
        "raw": report,
    }

    # 型号 / 序列号
    m = re.search(r"Device Model:\s*(.+)", report)
    if not m:
        m = re.search(r"Model Number:\s*(.+)", report)  # NVMe
    if m:
        info["model"] = m.group(1).strip()
    m = re.search(r"Serial Number:\s*(.+)", report)
    if m:
        info["serial"] = m.group(1).strip()

    # 整体健康自检
    m = re.search(r"SMART overall-health self-assessment test result:\s*(\w+)", report)
    if m:
        info["health"] = m.group(1).strip().upper()
    else:
        m = re.search(r"SMART Health Status:\s*(\w+)", report)
        if m:
            info["health"] = m.group(1).strip().upper()
        else:
            # NVMe
            m = re.search(r"(?:Health Status|SMART/Health)\s*.*?:\s*(.+)", report)
            if m and "OK" in m.group(1).upper():
                info["health"] = "PASSED"

    # ATA SMART 属性表
    attr_re = re.compile(
        r"^\s*(\d+)\s+(\S+)\s+0x[0-9a-fA-F]+\s+(\d+)\s+(\d+)\s+(\d+)\s+"
        r"(\S+)\s+(\S+)\s+(\S+)\s+(.+?)\s*$"
    )
    for line in report.splitlines():
        m = attr_re.match(line)
        if not m:
            continue
        aid, name, value, worst, thresh, atype, updated, when, raw = m.groups()
        raw_val = parse_raw(raw)
        info["attributes"][name] = {
            "id": int(aid),
            "value": int(value),
            "worst": int(worst),
            "thresh": int(thresh),
            "raw": raw_val,
            "raw_str": raw.strip(),
            "when_failed": when,
        }
        if name in TEMP_ATTR_NAMES and raw_val is not None:
            info["temperature"] = raw_val

    # NVMe 温度 (找不到属性表时兜底)
    if info["temperature"] is None:
        m = re.search(r"Temperature:\s*(\d+)\s*Celsius", report)
        if m:
            info["temperature"] = int(m.group(1))

    return info


def parse_raw(raw):
    """SMART RAW_VALUE 通常是整数, 有时带后缀(如 '35 (Min/Max ...)' 或 '200000000')。"""
    m = re.match(r"(-?\d+)", raw.strip())
    if m:
        try:
            return int(m.group(1))
        except ValueError:
            return None
    return None


# --------------------------------------------------------------------------
# 阈值评估
# --------------------------------------------------------------------------
def parse_threshold_spec(spec):
    """'value:below:90, raw:above:0' -> [(field, direction, limit), ...]"""
    rules = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        m = re.match(r"^(value|raw):(below|above):(-?\d+(?:\.\d+)?)$", part, re.IGNORECASE)
        if m:
            rules.append((m.group(1).lower(), m.group(2).lower(), float(m.group(3))))
    return rules


def evaluate(disks, cfg):
    """返回 [(disk, metric, value, threshold_desc), ...] 告警列表。"""
    violations = []
    thresholds = cfg["thresholds"]
    temp_max = cfg["alert"].get("temp_max", "").strip()

    # 便捷温度阈值 -> 视为 Temperature 属性 raw:above:N
    if temp_max:
        try:
            thresholds = dict(thresholds)
            thresholds.setdefault("__TEMP__", "raw:above:%s" % temp_max)
        except (ValueError, TypeError):
            pass

    for d in disks:
        # 整体健康
        if cfg["alert"].getboolean("health_check") and d["health"] is not None:
            if d["health"] != "PASSED":
                violations.append((d, "整体健康自检", d["health"] or "UNKNOWN",
                                   "应为 PASSED"))

        # 温度(RAW, 便捷阈值)
        if temp_max and d["temperature"] is not None:
            try:
                limit = float(temp_max)
                if d["temperature"] > limit:
                    violations.append((d, "温度", "%d℃" % d["temperature"], "> %d℃" % int(limit)))
            except (ValueError, TypeError):
                pass

        # 各属性模板值
        for name, spec in thresholds.items():
            if name == "__TEMP__":
                continue
            if name not in d["attributes"]:
                continue
            attr = d["attributes"][name]
            for field, direction, limit in parse_threshold_spec(spec):
                cur = attr["value"] if field == "value" else attr["raw"]
                if cur is None:
                    continue
                hit = (direction == "below" and cur < limit) or \
                      (direction == "above" and cur > limit)
                if hit:
                    cmp_op = "<" if direction == "below" else ">"
                    violations.append((
                        d,
                        "%s (%s)" % (name, field),
                        "%s" % cur,
                        "%s %s" % (cmp_op, int(limit) if limit == int(limit) else limit),
                    ))
    return violations


# --------------------------------------------------------------------------
# 邮件内容
# --------------------------------------------------------------------------
def build_summary(disks, violations):
    lines = ["检测到 %d 块磁盘，其中 %d 项指标异常：\n" % (len(disks), len(violations))]
    for d, metric, value, threshold in violations:
        lines.append("  • %s (%s): %s = %s，阈值 %s" % (
            d["device"], (d["model"] or "未知型号"), metric, value, threshold))
    lines.append("\n完整 SMART 报告见附件。")
    return "\n".join(lines)


def build_html(disks, violations):
    rows = ""
    for d, metric, value, threshold in violations:
        rows += (
            "<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n"
            % (escape(d["device"]), escape(d["model"] or "未知型号"),
               escape(metric), escape(str(value)), escape(str(threshold)))
        )
    return """\
<html><body>
<p>检测到 %d 块磁盘，其中 <b>%d</b> 项 SMART 指标异常：</p>
<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse">
<tr style="background:#f44336;color:#fff">
<th>设备</th><th>型号</th><th>指标</th><th>当前值</th><th>阈值</th></tr>
%s
</table>
<p style="color:#888;font-size:12px">完整 SMART 报告见邮件纯文本正文。</p>
</body></html>""" % (len(disks), len(violations), rows)


def escape(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


# --------------------------------------------------------------------------
# 冷却
# --------------------------------------------------------------------------
def load_state(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:  # noqa: BLE001
        return {}


def save_state(path, state):
    try:
        os.makedirs(os.path.dirname(path) or "/var/lib/smartctl", mode=0o755, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(state, f)
    except Exception:  # noqa: BLE001
        pass


def is_cooldown(violations, cfg):
    cooldown = cfg["alert"].getint("cooldown_minutes")
    if cooldown <= 0 or not violations:
        return False
    state_file = cfg["alert"]["state_file"]
    state = load_state(state_file)

    sig_parts = ["%s|%s|%s|%s" % (d["device"], d["model"], m, v)
                 for d, m, v, _ in violations]
    sig = hashlib.sha256("\n".join(sorted(sig_parts)).encode("utf-8")).hexdigest()[:16]

    now = datetime.now(timezone.utc)
    if state.get("last_signature") == sig:
        try:
            last = datetime.fromisoformat(state["last_alert_time"])
            if not last.tzinfo:
                last = last.replace(tzinfo=timezone.utc)
            elapsed = (now - last).total_seconds() / 60.0
            if elapsed < cooldown:
                print("同一告警冷却中 (%.0f/%.0f min)，跳过发送" % (elapsed, cooldown))
                return True
        except Exception:  # noqa: BLE001
            pass

    state["last_signature"] = sig
    state["last_alert_time"] = now.isoformat()
    save_state(state_file, state)
    return False


# --------------------------------------------------------------------------
# 发送
# --------------------------------------------------------------------------
def send_email(cfg, subject, text_body, html_body=None):
    s = cfg["smtp"]
    to_addrs = [a.strip() for a in s["to"].split(",") if a.strip()]
    if not to_addrs:
        print("未配置收件人 (smtp.to)", file=sys.stderr)
        return False

    msg = [
        "From: %s" % s["from"],
        "To: %s" % ", ".join(to_addrs),
        "Subject: %s" % subject,
        "Date: %s" % datetime.now(timezone.utc).strftime("%a, %d %b %Y %H:%M:%S +0000"),
        "MIME-Version: 1.0",
    ]
    if html_body:
        boundary = "smartctl-boundary-%d" % int(datetime.now().timestamp())
        msg.append("Content-Type: multipart/alternative; boundary=%s" % boundary)
        msg.append("")
        msg.append("--%s" % boundary)
        msg.append("Content-Type: text/plain; charset=utf-8")
        msg.append("")
        msg.append(text_body)
        msg.append("")
        msg.append("--%s" % boundary)
        msg.append("Content-Type: text/html; charset=utf-8")
        msg.append("")
        msg.append(html_body)
        msg.append("")
        msg.append("--%s--" % boundary)
    else:
        msg.append("Content-Type: text/plain; charset=utf-8")
        msg.append("")
        msg.append(text_body)
    data = "\n".join(msg)
    host, port = s["host"], int(s["port"])

    def auth(srv):
        if s["user"]:
            srv.login(s["user"], s["password"])

    try:
        if s.getboolean("use_ssl"):
            with smtplib.SMTP_SSL(host, port, context=ssl.create_default_context()) as srv:
                auth(srv)
                srv.sendmail(s["from"], to_addrs, data)
        else:
            with smtplib.SMTP(host, port) as srv:
                if s.getboolean("use_tls"):
                    srv.starttls(context=ssl.create_default_context())
                auth(srv)
                srv.sendmail(s["from"], to_addrs, data)
        return True
    except Exception as exc:  # noqa: BLE001
        print("邮件发送失败: %s" % exc, file=sys.stderr)
        return False


# --------------------------------------------------------------------------
# 主流程
# --------------------------------------------------------------------------
def main(argv):
    dry_run = "--dry-run" in argv or "-n" in argv
    cfg = load_config(os.environ.get("SMARTCTL_EMAIL_CONF", DEFAULT_CONF))

    disks_meta = discover_disks(cfg)
    if not disks_meta:
        print("未发现任何磁盘 (scan_all=%s)。" % cfg["alert"].get("scan_all"), file=sys.stderr)
        return 1

    disks = []
    for dev, dtype in disks_meta:
        report = get_disk_report(cfg, dev, dtype)
        if report.startswith("ERROR"):
            print(report, file=sys.stderr)
            continue
        disks.append(parse_smart(report, dev))

    if not disks:
        print("未能解析任何磁盘的 SMART 信息。", file=sys.stderr)
        return 1

    if cfg["alert"]["mode"] == "daily":
        full = "\n\n".join(d["raw"] for d in disks)
        subject = "%s 每日 SMART 状态报告" % cfg["smtp"]["subject_prefix"]
        body = "HDD/SSD SMART 每日状态报告 (%d 块磁盘)\n\n" % len(disks) + full
        if dry_run:
            print("[dry-run] 每日报告主题: %s\n%s" % (subject, body[:500]))
            return 0
        ok = send_email(cfg, subject, body)
        print("每日报告已发送" if ok else "每日报告发送失败")
        return 0

    violations = evaluate(disks, cfg)
    if not violations:
        print("无告警：%d 块磁盘 SMART 指标均正常" % len(disks))
        return 0

    if not dry_run and is_cooldown(violations, cfg):
        return 0

    subject = "%s %d 项磁盘 SMART 指标异常" % (cfg["smtp"]["subject_prefix"], len(violations))
    text_body = build_summary(disks, violations) + "\n\n" + "\n\n".join(d["raw"] for d in disks)
    html_body = build_html(disks, violations)

    if dry_run:
        print("[dry-run] 主题: %s\n%s" % (subject, build_summary(disks, violations)))
        return 0

    ok = send_email(cfg, subject, text_body, html_body)
    print("告警已发送：%d 项指标异常" % len(violations) if ok else "告警发送失败")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
