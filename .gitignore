# ===== 以 . 开头的非必要文件 / 文件夹（必要项除外） =====
.*
!.gitignore
!.gitattributes
!.github/
!.dockerignore
!.env.example

# ===== 测试 / 覆盖率产物 =====
coverage/
htmlcov/
test-results/
playwright-report/
cypress/screenshots/
cypress/videos/

# ===== 构建产物 =====
build/
dist/
target/
out/
bin/
*.tsbuildinfo

# ===== autotools 本地构建产物（由 ./configure / make 生成，不应提交） =====
Makefile
config.h
config.status
stamp-h1
libtool
autom4te.cache/
*.o
*.lo

# ===== Python =====
__pycache__/
*.py[cod]
*.so
*.egg-info/
venv/

# ===== Node =====
node_modules/

# ===== 日志 =====
*.log
logs/

# ===== 操作系统 =====
Thumbs.db
ehthumbs.db

# ===== 项目专属（本地配置 / 打包输出） =====
default_config.json
wfp_config.json
release/
*.spec
